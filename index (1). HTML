<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SupportWarehouse Xpress | Global Logistics</title>

<style>
* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

body {
    font-family: Arial, sans-serif;
    color: #17243a;
    background: #f4f7fb;
}

header {
    background: #071d3b;
    color: white;
    padding: 25px 15px;
    text-align: center;
}

header h1 {
    font-size: 26px;
    letter-spacing: 1px;
}

nav {
    background: #123e70;
    padding: 16px;
    text-align: center;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 10px;
    font-weight: bold;
}

.hero {
    background: linear-gradient(120deg, #071d3b, #1763a5);
    color: white;
    text-align: center;
    padding: 85px 20px;
}

.hero h2 {
    font-size: 38px;
    margin-bottom: 18px;
}

.hero p {
    font-size: 17px;
    margin-bottom: 25px;
}

.button {
    display: inline-block;
    background: #f5a623;
    color: #071d3b;
    padding: 14px 25px;
    text-decoration: none;
    border-radius: 5px;
    font-weight: bold;
}

section {
    padding: 55px 20px;
    text-align: center;
}

section h2 {
    color: #071d3b;
    margin-bottom: 20px;
}

.services {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
    margin-top: 30px;
}

.card {
    background: white;
    width: 270px;
    padding: 28px;
    border-radius: 9px;
    box-shadow: 0 3px 12px #dce2eb;
}

.card h3 {
    color: #1763a5;
    margin-bottom: 12px;
}

.tracking {
    background: #e7eef7;
}

input {
    width: 90%;
    max-width: 420px;
    padding: 15px;
    margin: 15px;
    border: 1px solid #aaa;
    border-radius: 5px;
    font-size: 16px;
}

button {
    background: #123e70;
    color: white;
    padding: 15px 30px;
    border: none;
    border-radius: 5px;
    font-size: 16px;
    cursor: pointer;
}

.contact {
    background: white;
}

.contact a {
    color: #1763a5;
    font-weight: bold;
}

footer {
    background: #071d3b;
    color: white;
    text-align: center;
    padding: 30px 15px;
}

footer p {
    margin: 8px;
}

@media(max-width:600px) {
    .hero h2 {
        font-size: 29px;
    }

    nav a {
        display: inline-block;
        margin: 7px;
    }
}
</style>
</head>

<body>

<header>
<h1>SUPPORTWAREHOUSE XPRESS</h1>
<p>Your Trusted Courier & Logistics Partner</p>
</header>

<nav>
<a href="#home">Home</a>
<a href="#services">Services</a>
<a href="#tracking">Track Shipment</a>
<a href="#contact">Contact</a>
</nav>

<div class="hero" id="home">

<h2>Delivering Beyond Borders</h2>

<p>
Domestic and international courier,
parcel delivery and freight logistics services.
</p>

<a href="#tracking" class="button">
Track Your Shipment
</a>

</div>

<section id="services">

<h2>Our Logistics Services</h2>

<p>Explore our courier and logistics solutions.</p>

<div class="services">

<div class="card">
<h3>Domestic Shipping</h3>
<p>Parcel collection and delivery services within supported domestic destinations.</p>
</div>

<div class="card">
<h3>International Shipping</h3>
<p>International parcel delivery to destinations supported by our shipping partners.</p>
</div>

<div class="card">
<h3>Freight Forwarding</h3>
<p>Freight transportation and logistics coordination solutions.</p>
</div>

<div class="card">
<h3>Parcel Delivery</h3>
<p>Convenient parcel handling and delivery assistance.</p>
</div>

</div>
</section>

<section class="tracking" id="tracking">

<h2>Track Your Shipment</h2>

<p>
Enter your tracking number below to request a shipment update.
</p>

<form id="trackingForm">

<input
type="text"
id="trackingNumber"
placeholder="Enter your tracking number"
required>

<br>

<button type="submit">
Track Shipment
</button>

</form>

<p id="trackingMessage"></p>

</section>

<section class="contact" id="contact">

<h2>Contact Our Support Team</h2>

<p>
For shipping enquiries, delivery updates and assistance,
contact us by email.
</p>

<br>

<p>
Email:
<a href="mailto:warehousexpresss@gmail.com">
warehousexpresss@gmail.com
</a>
</p>

</section>

<footer>

<h3>SUPPORTWAREHOUSE XPRESS</h3>

<p>Courier | Shipping | Freight | Logistics</p>

<p>© 2026 SupportWarehouse Xpress</p>

</footer>

<script>

document.getElementById("trackingForm")
.addEventListener("submit", function(event) {

event.preventDefault();

const trackingNumber =
document.getElementById("trackingNumber").value.trim();

if (!trackingNumber) return;

const subject = encodeURIComponent(
"Shipment Tracking Enquiry - " + trackingNumber
);

const body = encodeURIComponent(
"Hello SupportWarehouse Xpress,\n\n" +
"Please provide an update on my shipment.\n\n" +
"Tracking Number: " + trackingNumber
);

document.getElementById("trackingMessage").textContent =
"Opening your email application to send your tracking enquiry.";

window.location.href =
"mailto:warehousexpresss@gmail.com?subject=" +
subject + "&body=" + body;

});

</script>

</body>
</html>
