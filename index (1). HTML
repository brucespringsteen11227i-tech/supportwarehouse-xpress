<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SupportWarehouse Xpress | Courier & Logistics</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, sans-serif;
    background: #f4f7fb;
    color: #222;
    line-height: 1.6;
}

header {
    background: #071d3b;
    color: white;
    padding: 25px 15px;
    text-align: center;
}

header h1 {
    font-size: 27px;
}

nav {
    background: #123e70;
    padding: 14px;
    text-align: center;
}

nav a {
    color: white;
    text-decoration: none;
    margin: 10px;
    font-weight: bold;
}

.hero {
    background: #0c315d;
    color: white;
    text-align: center;
    padding: 75px 20px;
}

.hero h2 {
    font-size: 34px;
    margin-bottom: 15px;
}

.hero p {
    font-size: 17px;
    margin-bottom: 25px;
}

.button {
    display: inline-block;
    background: #f5a623;
    color: #071d3b;
    padding: 13px 25px;
    border-radius: 5px;
    text-decoration: none;
    font-weight: bold;
}

section {
    padding: 45px 20px;
    text-align: center;
}

section h2 {
    color: #071d3b;
    margin-bottom: 20px;
}

.services {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 20px;
}

.card {
    background: white;
    padding: 25px;
    width: 280px;
    border-radius: 9px;
    box-shadow: 0 2px 12px #ddd;
}

.card h3 {
    color: #123e70;
    margin-bottom: 10px;
}

.tracking {
    background: #e7eef7;
}

input {
    width: 90%;
    max-width: 450px;
    padding: 15px;
    margin: 12px;
    border: 1px solid #bbb;
    border-radius: 5px;
}

button {
    background: #123e70;
    color: white;
    padding: 14px 30px;
    border: none;
    border-radius: 5px;
    cursor: pointer;
}

footer {
    background: #071d3b;
    color: white;
    padding: 30px 15px;
    text-align: center;
}

footer a {
    color: #f5a623;
}

</style>
</head>

<body>

<header>
<h1>SUPPORTWAREHOUSE XPRESS</h1>
<p>Your Trusted Courier & Logistics Partner</p>
</header>

<nav>
<a href="#home">Home</a>
<a href="#services">Services</a>
<a href="#tracking">Track Shipment</a>
<a href="#contact">Contact</a>
</nav>

<div class="hero" id="home">
<h2>Delivering Beyond Borders</h2>

<p>
Reliable domestic and international courier,
parcel delivery and freight logistics services.
</p>

<a href="#tracking" class="button">Track Your Shipment</a>
</div>

<section id="services">
<h2>Our Services</h2>

<div class="services">

<div class="card">
<h3>Domestic Delivery</h3>
<p>Parcel collection and delivery services within your country.</p>
</div>

<div class="card">
<h3>International Shipping</h3>
<p>International parcel transportation to supported destinations worldwide.</p>
</div>

<div class="card">
<h3>Freight Forwarding</h3>
<p>Logistics coordination and freight transportation solutions.</p>
</div>

<div class="card">
<h3>Parcel Management</h3>
<p>Shipment enquiries and delivery assistance for customers.</p>
</div>

</div>
</section>

<section class="tracking" id="tracking">

<h2>Track Your Shipment</h2>

<p>Enter your tracking number to request an update on your shipment.</p>

<form id="trackingForm">

<input
type="text"
id="trackingNumber"
placeholder="Enter your tracking number"
required>

<br>

<button type="submit">Submit Tracking Enquiry</button>

</form>

<p id="trackingMessage"></p>

</section>

<section id="contact">

<h2>Contact SupportWarehouse Xpress</h2>

<p>Need assistance with shipping, delivery or tracking?</p>

<p>Email us for enquiries and customer support.</p>

<p>
<a href="mailto:warehousexpresss@gmail.com">
warehousexpresss@gmail.com
</a>
</p>

</section>

<footer>

<h3>SUPPORTWAREHOUSE XPRESS</h3>

<p>Domestic & International Courier Services</p>

<p>© 2026 SupportWarehouse Xpress. All Rights Reserved.</p>

</footer>

<script>

document.getElementById("trackingForm")
.addEventListener("submit", function(event) {

event.preventDefault();

const number = document
.getElementById("trackingNumber")
.value.trim();

if (!number) return;

const subject = encodeURIComponent(
"Shipment Tracking Enquiry: " + number
);

const body = encodeURIComponent(
"Hello SupportWarehouse Xpress,\n\n" +
"Please provide an update on my shipment.\n" +
"Tracking Number: " + number
);

document.getElementById("trackingMessage").textContent =
"Opening your email application to send your tracking enquiry.";

window.location.href =
"mailto:warehousexpresss@gmail.com?subject=" +
subject + "&body=" + body;

});

</script>

</body>
</html>
