<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>SupportWarehouse Xpress | Global Courier & Logistics</title>

<meta name="description" content="SupportWarehouse Xpress provides domestic and international courier, parcel delivery, freight and logistics services.">

<style>
* {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

body {
  font-family: Arial, sans-serif;
  color: #172338;
  line-height: 1.6;
}

header {
  background: #0b1f3a;
  color: white;
  padding: 20px;
}

nav {
  max-width: 1100px;
  margin: auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 15px;
}

.logo {
  font-size: 21px;
  font-weight: bold;
}

nav a {
  color: white;
  text-decoration: none;
  margin: 8px;
}

.hero {
  background: linear-gradient(120deg,#07172b,#1264d8);
  color: white;
  padding: 85px 20px;
  text-align: center;
}

.hero h1 {
  font-size: 42px;
  margin-bottom: 15px;
}

.hero p {
  max-width: 650px;
  margin: auto;
  font-size: 17px;
}

.btn {
  display: inline-block;
  background: #ff9f1c;
  color: #0b1f3a;
  padding: 13px 25px;
  margin-top: 22px;
  border-radius: 6px;
  font-weight: bold;
  text-decoration: none;
  border: none;
  cursor: pointer;
}

section {
  padding: 65px 20px;
}

.container {
  max-width: 1100px;
  margin: auto;
}

h2 {
  color: #0b1f3a;
  text-align: center;
  margin-bottom: 25px;
  font-size: 30px;
}

.intro {
  text-align: center;
  max-width: 750px;
  margin: auto;
}

.tracking {
  background: #f1f5fa;
  text-align: center;
}

.tracking-box {
  background: white;
  padding: 30px;
  max-width: 550px;
  margin: auto;
  border-radius: 12px;
  box-shadow: 0 5px 25px #00000012;
}

input, textarea {
  width: 100%;
  padding: 14px;
  margin: 10px 0;
  border: 1px solid #ccc;
  border-radius: 6px;
  font-size: 15px;
}

.services {
  display: grid;
  grid-template-columns: repeat(auto-fit,minmax(230px,1fr));
  gap: 20px;
}

.card {
  padding: 25px;
  background: #f4f7fb;
  border-radius: 10px;
  border-bottom: 3px solid #1264d8;
}

.card h3 {
  color: #1264d8;
  margin-bottom: 10px;
}

.contact {
  background: #f1f5fa;
}

.contact-box {
  max-width: 650px;
  margin: auto;
  background: white;
  padding: 30px;
  border-radius: 12px;
}

.contact-box p {
  margin: 12px 0;
}

footer {
  background: #07172b;
  color: white;
  text-align: center;
  padding: 25px;
}

.whatsapp {
  position: fixed;
  bottom: 20px;
  right: 20px;
  background: #25d366;
  color: white;
  padding: 15px 19px;
  border-radius: 50px;
  text-decoration: none;
  font-weight: bold;
  box-shadow: 0 3px 12px #0003;
}

@media(max-width:600px) {
  .hero h1 {
    font-size: 32px;
  }

  nav {
    justify-content: center;
  }
}
</style>
</head>

<body>

<header>
<nav>
<div class="logo">🚚 SUPPORTWAREHOUSE XPRESS</div>

<div>
<a href="#home">Home</a>
<a href="#services">Services</a>
<a href="#about">About</a>
<a href="#contact">Contact</a>
</div>
</nav>
</header>

<section class="hero" id="home">
<div class="container">

<h1>Moving Your World Forward</h1>

<p>
Your trusted partner for courier, parcel delivery,
international shipping, freight and logistics solutions.
We help connect businesses and individuals across borders.
</p>

<a href="#tracking" class="btn">Track Your Shipment</a>

<a href="#contact" class="btn">Book a Delivery</a>

</div>
</section>

<section id="tracking" class="tracking">
<div class="container">

<h2>Track Your Shipment</h2>

<div class="tracking-box">

<p>Enter your shipment tracking number below.</p>

<form id="trackForm">

<input
type="text"
id="trackingNumber"
placeholder="Enter tracking number"
required
>

<button class="btn" type="submit">
Track Shipment
</button>

</form>

<p id="trackingResult"></p>

</div>
</div>
</section>

<section id="services">
<div class="container">

<h2>Our Services</h2>

<div class="services">

<div class="card">
<h3>📦 Parcel Delivery</h3>
<p>Reliable parcel collection and delivery solutions.</p>
</div>

<div class="card">
<h3>✈️ International Shipping</h3>
<p>International shipping assistance for destinations worldwide, subject to route availability.</p>
</div>

<div class="card">
<h3>🚚 Freight & Cargo</h3>
<p>Freight and cargo logistics solutions for businesses and individuals.</p>
</div>

<div class="card">
<h3>📄 Document Delivery</h3>
<p>Careful handling and transportation of important documents.</p>
</div>

<div class="card">
<h3>⚡ Express Delivery</h3>
<p>Time-conscious delivery arrangements for urgent shipments.</p>
</div>

<div class="card">
<h3>🏠 Door-to-Door Delivery</h3>
<p>Convenient pickup and delivery arrangements.</p>
</div>

</div>
</div>
</section>

<section id="about">
<div class="container">

<h2>About SupportWarehouse Xpress</h2>

<div class="intro">

<p>
SupportWarehouse Xpress is a courier and logistics
service brand focused on connecting people and
businesses through dependable delivery solutions.

Our goal is to make domestic and international
shipping simpler through customer-focused service,
clear communication and careful package handling.

We are committed to building a trusted logistics
network serving customers across the world.
</p>

</div>
</div>
</section>

<section class="tracking">
<div class="container">

<h2>How It Works</h2>

<div class="services">

<div class="card">
<h3>1. Book</h3>
<p>Contact us with your pickup and destination details.</p>
</div>

<div class="card">
<h3>2. Ship</h3>
<p>Confirm your delivery arrangements and shipment details.</p>
</div>

<div class="card">
<h3>3. Track</h3>
<p>Use your assigned tracking reference to request shipment updates.</p>
</div>

</div>
</div>
</section>

<section id="contact" class="contact">
<div class="container">

<h2>Contact Our Team</h2>

<div class="contact-box">

<p><strong>Company:</strong> SupportWarehouse Xpress</p>

<p>
<strong>Email:</strong>
<a href="mailto:warehousexpresss@gmail.com">
warehousexpresss@gmail.com
</a>
</p>

<p>
<strong>Phone:</strong>
<a href="tel:+16513299959">+1 651 329-9959</a>
</p>

<p><strong>Service Coverage:</strong> Worldwide enquiries</p>

<hr style="margin:20px 0">

<h3>Send a Delivery Enquiry</h3>

<form id="contactForm">

<input id="name" placeholder="Your full name" required>

<input id="email" type="email" placeholder="Your email address" required>

<input id="subject" placeholder="Subject" required>

<textarea id="message" rows="5" placeholder="Your message" required></textarea>

<button class="btn" type="submit">Send Enquiry</button>

</form>

</div>
</div>
</section>

<footer>

<p>© <span id="year"></span> SupportWarehouse Xpress.</p>

<p>Courier | International Shipping | Freight | Logistics</p>

</footer>

<a class="whatsapp"
href="https://wa.me/16513299959"
target="_blank">
WhatsApp Us
</a>

<script>

document.getElementById("year").textContent =
new Date().getFullYear();

document.getElementById("trackForm").addEventListener("submit",function(e){

e.preventDefault();

let tracking =
document.getElementById("trackingNumber").value.trim();

let message =
"Hello SupportWarehouse Xpress. I would like an update on my shipment. My tracking number is: " + tracking;

window.open(
"https://wa.me/16513299959?text=" +
encodeURIComponent(message),
"_blank"
);

document.getElementById("trackingResult").textContent =
"Your tracking enquiry is being prepared.";

});

document.getElementById("contactForm").addEventListener("submit",function(e){

e.preventDefault();

let name = document.getElementById("name").value;
let email = document.getElementById("email").value;
let subject = document.getElementById("subject").value;
let message = document.getElementById("message").value;

let body =
"Name: " + name +
"\nEmail: " + email +
"\nMessage: " + message;

window.location.href =
"mailto:warehousexpresss@gmail.com?subject=" +
encodeURIComponent(subject) +
"&body=" + encodeURIComponent(body);

});

</script>

</body>
</html>
